{
  "multipart": [
    {
      "when": {
        "double": "false",
        "facing": "north"
      },
      "apply": {
        "model": "endbound_ember:block/mud_brick_vertical_slab"
      }
    },
    {
      "when": {
        "double": "false",
        "facing": "east"
      },
      "apply": {
        "model": "endbound_ember:block/mud_brick_vertical_slab",
        "y": 90
      }
    },
    {
      "when": {
        "double": "false",
        "facing": "south"
      },
      "apply": {
        "model": "endbound_ember:block/mud_brick_vertical_slab",
        "y": 180
      }
    },
    {
      "when": {
        "double": "false",
        "facing": "west"
      },
      "apply": {
        "model": "endbound_ember:block/mud_brick_vertical_slab",
        "y": 270
      }
    },
    {
      "when": {
        "double": "true"
      },
      "apply": {
        "model": "minecraft:block/mud_bricks"
      }
    }
  ]
}
